  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/up", "host": ["{{baseUrl}}"], "path": ["up"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Classify",
      "item": [
        {
          "name": "Classify - Bug Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"App crashes on login\",\n  \"description\": \"Tapping Sign in closes the app immediately on iOS 17.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/classify", "host": ["{{baseUrl}}"], "path": ["api", "classify"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response has category, confidence, reasoning', function () {",
                  "    pm.expect(body).to.have.property('category');",
                  "    pm.expect(body).to.have.property('confidence');",
                  "    pm.expect(body).to.have.property('reasoning');",
                  "});",
                  "",
                  "pm.test('Category is bug', function () {",
                  "    pm.expect(body.category).to.eql('bug');",
                  "});",
                  "",
                  "pm.test('Confidence is between 0 and 1', function () {",
                  "    pm.expect(body.confidence).to.be.at.least(0).and.at.most(1);",
                  "});"
                ]
              }
            }
          ]
        },
