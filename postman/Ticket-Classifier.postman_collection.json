    {
      "name": "Rate Limiting",
      "description": "Run this folder alone via Collection Runner with 6 iterations and 0ms delay. Requests 1-5 should return 200, request 6 should return 429.",
      "item": [
        {
          "name": "Classify - Rate Limit Probe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"App crashes on login\",\n  \"description\": \"Tapping Sign in closes the app immediately.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/classify", "host": ["{{baseUrl}}"], "path": ["api", "classify"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const iteration = pm.info.iteration;",
                  "",
                  "if (iteration < 5) {",
                  "    pm.test('Request ' + (iteration + 1) + ' of 6 is allowed (200)', function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "} else {",
                  "    pm.test('Request ' + (iteration + 1) + ' of 6 is rate limited (429)', function () {",
                  "        pm.response.to.have.status(429);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
